<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dgrid="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UchebkaFinal.StudentUC"
             FontFamily="Consolas"
        Background="#FCFAF5"
        Foreground="#5C574F">

  <Grid Margin="8" RowDefinitions="Auto, Auto, *">
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Search for name:" VerticalAlignment="Center"/>
      <TextBox x:Name="SurnameFilterTextBox" Width="200"
               TextChanged="SurnameFilterTextBox_TextChanged"/>
      
      <Button Content="Reset" Click="Button_Click_1"/>
    </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal">
      <Button Content="Create" Click="Button_Click_3" />
      <Button Content="Delete" Click="Button_Click_4" />
      <TextBlock x:Name="ErrorTextBlock"
           Grid.Row="1"
           Foreground="Red"
           FontSize="14"
           Margin="8,0,0,0"
           IsVisible="False"/>
          
    </StackPanel>   
          <DataGrid x:Name="StudentsGrid" Grid.Row="2" AutoGenerateColumns="False"
              IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="ID" Binding="{Binding RegNum}" />
        <DataGridTextColumn Header="Name" Binding="{Binding FullName}" />
        <DataGridTextColumn Header="Program" Binding="{Binding ProgramCode}" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
