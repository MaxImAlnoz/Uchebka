<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UchebkaFinal.CourceUC">
  <Grid Margin="8" RowDefinitions="Auto,*">
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Title filter:" VerticalAlignment="Center"/>
      <TextBox x:Name="TitleFilterTextBox" Width="200" TextChanged="TitleFilterTextBox_TextChanged"/>
      <Button Content="Search" Click="Button_Click"/>
      <Button Content="Sbros" Click="Button_Click_1"/>
    </StackPanel>

    <DataGrid x:Name="CoursesGrid" Grid.Row="1" AutoGenerateColumns="False"
              IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="ID" Binding="{Binding CourseId}" />
        <DataGridTextColumn Header="Title" Binding="{Binding Title}" />
        <DataGridTextColumn Header="Kafedra" Binding="{Binding DeptCode}" />
        <DataGridTextColumn Header="Hours" Binding="{Binding Workload}" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
