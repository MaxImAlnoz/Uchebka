<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="UchebkaFinal.NextW"
        Title="NextW"
        FontFamily="Consolas">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8">
      <TextBlock Text="Роль:" VerticalAlignment="Center"/>
      <TextBlock x:Name="RoleTextBlock" FontWeight="Bold"
                 VerticalAlignment="Center" Margin="4,0,16,0"/>

      <Button x:Name="StudentsButton" Content="Студенты" Click="StudentsButton_Click"/>
      <Button x:Name="ExamsButton" Content="Экзамены" Click="ExamsButton_Click"/>
      <Button x:Name="StaffButton" Content="Сотрудники" Click="StaffButton_Click"/>
      <Button x:Name="CoursesButton" Content="Курсы" Click="CoursesButton_Click"/>
    </StackPanel>

    <ContentControl Grid.Row="1" x:Name="ContentCon">
    </ContentControl>
  </Grid>
</Window>
